# Python
__pycache__/
*.py[cod]
*$py.class
.Python

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment variables (never commit real secrets)
.env
.env.*
!.env.example

# Generated data / outputs (keep directories, ignore contents)
data/*
outputs/*
!data/.gitkeep
!outputs/.gitkeep

# Public MVP validation (011): the captured Amazon snapshot is versioned static
# content; the runtime SQLite registration/feedback/event store is not.
!data/amazon_snapshot.json
data/public.db

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

valueproposition/*
